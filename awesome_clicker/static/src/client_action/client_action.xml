<templates xml:space="preserve">

     <t t-name="awesome_clicker.ClickerClientAction">
         <div class="ms-1 mt-1 mb-2">
             <span>Clicks: <ClickerValue/> </span>
	         <button class="btn btn-primary ms-1" t-on-click="() => this.clickService.increment(9)">
                 Increment
             </button>
         </div>

	     <Notebook>

             <t t-set-slot="clicks" title="'Clicks'" isVisible="this.clickService.level >= 1">

                 <div class="ms-1 mt-1">
                     <h2> Bots </h2>
	                 <div class="d-flex flex-row">
                         <t t-foreach="this.clickService.bots" t-as="bot" t-key="bot">
                             <div t-if="bot_value.level lte this.clickService.level" class="card me-3">
                                 <div class="card-header">
                                     <t t-esc="bot_value.purchased"/>x <t t-esc="bot"/> (<t t-esc="bot_value.increment * this.clickService.multiplier"/> clicks/10seconds)
	                                 <i class="fa fa-android"></i>
                                 </div>
	                             <div class="card-body">
                                     <button t-on-click="() => this.clickService.buyBot(bot)" class="btn btn-primary" t-att-disabled="this.clickService.clicks lt bot_value.price">
                                         Buy <t t-esc="bot"/> (<t t-esc="bot_value.price"/> clicks)
                                     </button>
                                 </div>
                             </div>
                         </t>
                     </div>
                 </div>

	             <div t-if="this.clickService.level >= 3" class="ms-1 mt-1">
                     <h2> Power multiplier </h2>
		             <div class="d-flex flex-row">
                         <div class="card me-3">
                             <div class="card-header">
                                 <t t-esc="this.clickService.multiplier"/>x
	                             <i class="fa fa-superpowers"></i>
                             </div>
	                         <div class="card-body">
                                 <button t-on-click="() => this.clickService.buyMultiplier()" class="btn btn-primary" t-att-disabled="this.clickService.clicks lt 50000">
                                     Buy Power Multiplier (50000 clicks)
                                 </button>
                             </div>
                         </div>
                     </div>
                 </div>

             </t>

		     <t t-set-slot="trees" title="'Trees and Fruits'" isVisible="this.clickService.level >=4">

                 <div class="ms-1 mt-1">

                     <h2> Trees </h2>
	                 <div class="d-flex flex-row">
                         <t t-foreach="this.clickService.trees" t-as="tree" t-key="tree">
                             <div t-if="tree_value.level lte this.clickService.level" class="card me-3">
                                 <div class="card-header">
                                     <t t-esc="tree_value.purchased"/>x <t t-esc="tree"/> (1x <t t-esc="tree_value.produce"/> /30seconds)
	                                 <i class="fa fa-tree"></i>
                                 </div>
	                             <div class="card-body">
                                     <button t-on-click="() => this.clickService.buyTree(tree)" class="btn btn-primary" t-att-disabled="this.clickService.clicks lt tree_value.price">
                                         Buy <t t-esc="tree"/> (<t t-esc="tree_value.price"/> clicks)
                                     </button>
                                 </div>
                             </div>
                         </t>
                     </div>

	                 <h2> Fruits </h2>
	                 <div class="d-flex flex-row">
                         <t t-foreach="this.clickService.fruits" t-as="fruit" t-key="fruit">
                             <div class="card me-3">
                                 <div class="card-header">
                                     <t t-esc="fruit_value"/>x <t t-esc="fruit"/>
                                 </div>
                             </div>
                         </t>
                     </div>

                 </div>

             </t>

         </Notebook>

     </t>

 </templates>