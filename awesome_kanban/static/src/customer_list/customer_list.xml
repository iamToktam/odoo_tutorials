<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
	<t t-name="awesome_kanban.CustomerList">
		<table class="table table-striped">
			<thead>
				<tr>
					<td>
						<span> Customers  With Active Orders </span>
                        <div class="form-check">

							<input class="form-check-input"
                                   type="checkbox" value=""
                                   id="CheckDefault"
                                   t-on-change="onChangeActiveCustomers"/>

                            <label class="form-check-label" for="CheckDefault">
								Active Customers
							</label>

						</div>
					</td>
				</tr>
			</thead>
            <tbody>

				<tr>
					<td>
						<input class="o_input w-100"
							   placeholder="Filter customers"
							   t-on-input="onCustomerFilter"/>
					</td>
				</tr>

                <tr t-foreach="displayedPartners.data"
					t-as="partner"
					t-key="partner.id"
					class="o_awesome_kanban_customer_hover">

					<td class="cursor-pointer"
                        t-esc="partner.display_name"
                        t-on-click="() => props.selectCustomer(partner.id, partner.display_name)"/>

				</tr>
			</tbody>
		</table>
	</t>
        </templates>